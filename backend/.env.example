# TikiTaka Backend Environment Variables
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# FRONTEND_URL supports single or comma-separated origins (e.g. https://tikitaka.vercel.app,http://localhost:5173)
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
