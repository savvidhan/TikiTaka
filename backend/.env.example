# TikiTaka Backend Environment Configuration
# Local Development: PORT=5000 | Production: Render/Railway will assign PORT automatically (or set to 10000)
PORT=5000

# MongoDB Connection String (MongoDB Atlas replica set or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Approved Frontend Origins for CORS & CSRF defense
# In Production: set to your deployed Vercel domain (e.g., https://tikitaka.vercel.app)
# Supports comma-separated list of origins if deploying multiple domains
FRONTEND_URL=http://localhost:5173

# Node Environment: 'development', 'production', or 'test'
# In Production (Render/Railway): MUST be set to production
NODE_ENV=development

# JWT Secret: Required in production. Minimum 32 random characters.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars

# JWT Validity Duration (e.g. '7d', '24h', '1h')
JWT_EXPIRES_IN=7d

# Cookie SameSite Policy:
# Local development (same origin / localhost): 'lax'
# Cross-domain production (e.g. frontend on Vercel and backend on Render): 'none'
# When COOKIE_SAMESITE=none, Secure=true is automatically enforced
COOKIE_SAMESITE=lax
